{
    "fileType": "VehicleConfig",
    "version": 1,
    "imports": [
        "QGroundControl.AutoPilotPlugins.PX4"
    ],
    "controllerType": "PowerComponentController",
    "params": {
        "_uavcanEnable": "UAVCAN_ENABLE",
        "_uavcanAvailable": {
            "name": "UAVCAN_ENABLE",
            "existsOnly": true
        }
    },
    "sections": [
        {
            "title": "电池",
            "keywords": [
                "battery",
                "voltage",
                "current",
                "power module",
                "sensor",
                "cells",
                "lipo"
            ],
            "image": "/qmlimages/Battery.svg",
            "repeat": {
                "paramPrefix": "BAT",
                "probePostfix": "_SOURCE",
                "startIndex": 1,
                "firstIndexOmitsNumber": false
            },
            "controls": [
                {
                    "param": "_SOURCE",
                    "label": "来源",
                    "control": "combobox"
                },
                {
                    "param": "_N_CELLS",
                    "label": "串联电芯数",
                    "optional": true,
                    "showWhen": "controller.parameterExists(-1, _fullParamName(\"_N_CELLS\"))"
                },
                {
                    "param": "_V_EMPTY",
                    "label": "空电电压（每芯）",
                    "optional": true,
                    "showWhen": "controller.parameterExists(-1, _fullParamName(\"_V_EMPTY\"))"
                },
                {
                    "param": "_V_CHARGED",
                    "label": "满电电压（每芯）",
                    "optional": true,
                    "showWhen": "controller.parameterExists(-1, _fullParamName(\"_V_CHARGED\"))"
                },
                {
                    "param": "_V_DIV",
                    "label": "电压分压比",
                    "optional": true,
                    "showWhen": "controller.parameterExists(-1, _fullParamName(\"_V_DIV\"))",
                    "control": "dialogButton",
                    "dialogButton": {
                        "text": "计算",
                        "dialogComponent": "CalcVoltageDividerDialog",
                        "buttonAfter": false,
                        "dialogParams": {
                            "batteryIndex": "_rawIndex"
                        }
                    }
                },
                {
                    "param": "_A_PER_V",
                    "label": "安培/伏特",
                    "optional": true,
                    "showWhen": "controller.parameterExists(-1, _fullParamName(\"_A_PER_V\"))",
                    "control": "dialogButton",
                    "dialogButton": {
                        "text": "计算",
                        "dialogComponent": "CalcAmpsPerVoltDialog",
                        "buttonAfter": false,
                        "dialogParams": {
                            "batteryIndex": "_rawIndex"
                        }
                    }
                },
                {
                    "param": "_V_LOAD_DROP",
                    "label": "Voltage drop on full load (per cell)",
                    "optional": true,
                    "showWhen": "controller.parameterExists(-1, _fullParamName(\"_V_LOAD_DROP\"))"
                }
            ]
        },
        {
            "title": "ESC PWM 最小/最大值校准",
            "keywords": [
                "esc",
                "calibration",
                "motor",
                "pwm",
                "electronic speed controller"
            ],
            "image": "/qmlimages/Gears.svg",
            "controls": [
                {
                    "control": "label",
                    "label": "WARNING: Propellers must be removed from vehicle prior to performing ESC calibration.",
                    "warning": true
                },
                {
                    "control": "label",
                    "label": "You must use USB connection for this operation."
                },
                {
                    "control": "dialogButton",
                    "dialogButton": {
                        "text": "Calibrate",
                        "dialogComponent": "ESCCalibrationDialog"
                    }
                }
            ]
        },
        {
            "title": "UAVCAN 总线配置",
            "keywords": [
                "uavcan",
                "can bus",
                "dronecan",
                "esc",
                "node"
            ],
            "image": "/qmlimages/Gears.svg",
            "controls": [
                {
                    "param": "UAVCAN_ENABLE",
                    "label": "UAVCAN",
                    "control": "combobox",
                    "optional": true,
                    "showWhen": "_uavcanAvailable"
                },
                {
                    "control": "label",
                    "label": "当前固件未提供 UAVCAN_ENABLE 参数。",
                    "showWhen": "!_uavcanAvailable"
                },
                {
                    "control": "label",
                    "label": "更改后需要重启。"
                }
            ]
        },
        {
            "title": "UAVCAN 电机编号和方向分配",
            "keywords": [
                "uavcan",
                "can bus",
                "dronecan",
                "esc",
                "node",
                "assignment",
                "motor direction"
            ],
            "image": "/qmlimages/Gears.svg",
            "showWhen": "_uavcanAvailable && _uavcanEnable && _uavcanEnable.rawValue !== 0",
            "controls": [
                {
                    "control": "label",
                    "label": "警告：在执行 UAVCAN 电调配置前，必须先拆下螺旋桨。",
                    "warning": true
                },
                {
                    "control": "label",
                    "label": "执行分配后，才能在编辑器中访问电调参数。"
                },
                {
                    "control": "label",
                    "label": "启动流程后，请按照电机编号顺序，将每个电机转到其对应的旋转方向。"
                },
                {
                    "control": "actionButton",
                    "actionButton": {
                        "text": "开始分配",
                        "onClicked": "controller.startBusConfigureActuators()"
                    }
                },
                {
                    "control": "actionButton",
                    "actionButton": {
                        "text": "停止分配",
                        "onClicked": "controller.stopBusConfigureActuators()"
                    }
                }
            ]
        }
    ]
}
